{
  "name": "dsh-chapter-whale",
  "version": "0.4.2",
  "private": false,
  "description": "码章鲸：DSH 全自动小说写作与番茄发布，支持自定义日更任务、无人值守运行、部分免费模型与厂商账号登录。ChapterWhale: scheduled, unattended novel writing and Fanqie publishing for Windows x64.",
  "type": "module",
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "author": {
    "name": "thus-zhou"
  },
  "icon": "icon.svg",
  "homepage": "https://github.com/thus-zhou/dsh-chapter-whale#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thus-zhou/dsh-chapter-whale.git"
  },
  "bugs": {
    "url": "https://github.com/thus-zhou/dsh-chapter-whale/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "ai-writing",
    "fiction",
    "fanqie",
    "publishing",
    "小说",
    "网文",
    "AI写作",
    "番茄小说",
    "自动发布",
    "automation",
    "unattended",
    "novel-writing",
    "free-models",
    "码章鲸"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "package.json",
    "managed-runtime.mjs",
    "backend/",
    "runtime-manifest.json",
    "THIRD_PARTY_NOTICES.md",
    "runtime-download.json",
    "RELEASE_STATUS.md",
    "docs/",
    "assets/",
    "screenshots.json",
    "scripts/check-release.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs test/gate.test.mjs test/manifest.test.mjs test/market.test.mjs test/stop.test.mjs test/distribution.test.mjs",
    "prepublishOnly": "node scripts/check-release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
